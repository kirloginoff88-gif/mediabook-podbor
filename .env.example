# Скопируйте в .env (для VPS) или задайте эти переменные в настройках Vercel. Сам .env в git не попадает.

# Токен бота от @BotFather (обязательно)
TG_TOKEN=

# Пароль страницы /setup, где бот подключается одной кнопкой (обязательно)
ADMIN_PASSWORD=

# ID чата менеджеров для заявок; узнать — написать боту /chatid в нужном чате. Можно несколько через запятую
MANAGER_CHAT_ID=

# Входящий вебхук Битрикс24 с правом CRM, по желанию: https://company.bitrix24.ru/rest/1/xxxxxxxx/
B24_WEBHOOK=

# Публичный адрес. На Vercel не нужен — определяется сам. На VPS: https://podbor.example.ru
PUBLIC_URL=

# Кого называть в ответах клиенту
MANAGER_NAME=Анна
MANAGER_PHONE=+7 (918) 918-03-40
